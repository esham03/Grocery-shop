# ==========================================
# FreshGrocer - Environment Variables Template
# ==========================================

# Django Settings
DJANGO_SECRET_KEY=freshgrocer-insecure-development-secret-key-change-in-prod-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Default: SQLite (backend/db.sqlite3) when DATABASE_URL is unset.
# For production PostgreSQL: postgresql://username:password@localhost:5432/freshgrocer_db
DATABASE_URL=

# Business Rules & Currency Settings
FRESHGROCER_CURRENCY=INR
FRESHGROCER_CURRENCY_SYMBOL=₹
FRESHGROCER_FREE_DELIVERY_THRESHOLD=499.00
FRESHGROCER_STANDARD_DELIVERY_FEE=40.00

# Frontend Configuration
VITE_API_BASE=http://localhost:8000/api/v1
